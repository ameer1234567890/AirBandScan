# AirBandScan configuration (edited by the web UI)
# Frequencies in MHz; ranges as lo-hi, comma separated.
autostart = 1
bias_tee = 0
channel_bw_khz = 8
channel_step_khz = 8.333333
# modulation: am (airband) | nfm (narrow FM; use channel_bw_khz = 12.5)
modulation = am
# device: rtlsdr | rtltcp | airspy | airspyhf | sdrplay | hackrf | pluto | wav
device = rtlsdr
device_index = 0
dwell_ms = 500
gain_db = 40
http_bind = 0.0.0.0
http_port = 8080
# rtl_tcp server (device = rtltcp): host:port
# rtltcp_address = 127.0.0.1:1234
# PlutoSDR address: ip:192.168.2.1 (USB network / Ethernet), ip:pluto.local, usb:1.4.5; empty = auto
# pluto_uri = ip:192.168.2.1
ignored = 131.525, 131.55, 131.725, 131.825, 136.7-136.975
keep_other = 1
max_duration_s = 120
min_duration_ms = 500
mp3_auto = 1
mp3_bitrate = 32
noise_learn_ms = 1500
ppm = 0
preroll_ms = 300
ranges = 118-137
recordings_dir = recordings
retention_days = 0
# What runs (and starts at launch): scanner (airband) | satellite (SSTV / Meteor LRPT)
run_mode = scanner
# Satellite receiver: sat_mode sstv | lrpt; ISS SSTV 145.8, Meteor-M LRPT 137.9 (or 137.1)
sat_mode = sstv
sat_freq_mhz = 145.8
# m2x = Meteor-M N2-3 / N2-4 (OQPSK); m2 = retired Meteor-M N2 (QPSK)
sat_lrpt_variant = m2x
# FM channel width for SSTV, Doppler included
sat_sstv_bw_khz = 30
sample_rate = 2400000
start_level_db = 6
stop_level_db = 3
timeout_ms = 1200
voice_threshold = 0.5
wav_center_mhz = 120
wav_path = 
